{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesk",
  "version": "0.1.0",
  "identifier": "dev.vencord.vesk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
